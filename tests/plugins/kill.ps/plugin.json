{
  "manifest": 1,
  "id": "kill.ps",
  "name": {"zh": "结束进程", "en": "Kill process"},
  "version": "1.0.0",
  "description": "测试用的常驻 PowerShell 插件：kill <进程名或 PID> 列出进程（名字、PID、内存、exe 的图标），Enter 结束，Ctrl+Enter 连同子进程",
  "runtime": {"mode": "resident", "program": "powershell", "script": "main.ps1", "timeoutMs": 5000},
  "permissions": ["processes"],
  "commands": [{
    "id": "kill",
    "keyword": ["kill", "jc"],
    "title": {"zh": "结束进程", "en": "Kill process"},
    "icon": "glyph:U+E711",
    "hint": {"zh": "进程名或 PID", "en": "Process name or PID"},
    "actions": [
      {"id": "kill", "title": {"zh": "结束", "en": "Kill"}, "key": "Enter"},
      {"id": "killTree", "title": {"zh": "连同子进程一起结束", "en": "Kill with children"}, "key": "Ctrl+Enter"}
    ]
  }]
}
